// Wayfinder is a small Amplifier bundle that gives an assistant a warm, guide-like
// voice: it learns how to speak, how to offer help without pushing, and what kinds of
// help it can offer.

digraph wayfinder {
    rankdir=LR
    fontname="Helvetica"
    fontsize=12
    label="Wayfinder — A Friendly Guide Personality\nGives an assistant a warm voice, a polite way to offer help, and a menu of things it can do"
    labelloc=t
    labeljust=c
    nodesep=0.6
    ranksep=0.7
    bgcolor="white"
    source_hash="0c4c2518197ed2deb0f77ac6cd893955b8b85820c9a260c8f6af3b30ecfc6f82"

    node [fontname="Helvetica", fontsize=11, style="filled,rounded"]
    edge [fontname="Helvetica", fontsize=9]

    root_wayfinder [label="Wayfinder — Main Package v0.1.0\nThe starting point that pulls everything together\n0 tools · 0 agents\n~334 tok aggregate", shape=box, fillcolor="#80cbc4", style="filled,rounded,bold", penwidth=2]

    subgraph cluster_behaviors {
        label="Reusable Capability Pack — the guide personality, ready to add to any assistant"
        style="filled"
        fillcolor="#f9f9f9"
        color="#999999"

        beh_wayfinder_behavior [label="Guide Personality Pack\nBundles the three guidance documents together\n3 ctx\n~1461 tok", shape=box, fillcolor="#e0f2f1", style="filled,rounded"]
    }

    subgraph cluster_context {
        label="Written Guidance — plain documents the assistant reads before it speaks"
        style="filled"
        fillcolor="#f9f9f9"
        color="#999999"

        ctx_wayfinder_voice_md [label="How to Speak — Tone & Personality\nwayfinder-voice.md\n~504 tok", shape=box, fillcolor="#e1bee7", style="filled,rounded"]
        ctx_propose_and_ack_md [label="How to Offer Help — Suggest, Then Wait\npropose-and-ack.md\n~376 tok", shape=box, fillcolor="#e1bee7", style="filled,rounded"]
        ctx_offer_catalog_md [label="What Help Is Available — Menu of Offers\noffer-catalog.md\n~412 tok", shape=box, fillcolor="#e1bee7", style="filled,rounded"]
    }

    subgraph cluster_legend {
        label="Legend — what the shapes and colors mean"
        style="filled"
        fillcolor="white"
        color="#cccccc"
        fontsize=9

        leg_root [label="main package", shape=box, fillcolor="#80cbc4", style="filled,rounded,bold", fontsize=9]
        leg_behavior [label="capability pack", shape=box, fillcolor="#e0f2f1", style="filled,rounded", fontsize=9]
        leg_agent [label="specialist helper", shape=box, fillcolor="#c8e6c9", style="filled,rounded", fontsize=9]
        leg_module [label="code component", shape=box, fillcolor="#bbdefb", style="filled,rounded", fontsize=9]
        leg_provider [label="AI service", shape=box, fillcolor="#e0e0e0", style="filled,rounded", fontsize=9]
        leg_context [label="written guidance", shape=box, fillcolor="#e1bee7", style="filled,rounded", fontsize=9]
        leg_standalone [label="ready to run", shape=box, fillcolor="#80cbc4", style="filled,rounded", fontsize=9]
        leg_experiment [label="experiment", shape=box, fillcolor="#e1bee7", style="filled,rounded", fontsize=9]
        leg_ext_cost [label="borrowed, adds reading cost", shape=box, fillcolor="#80cbc4", style="dashed", color="red", penwidth=2, fontsize=9]
        leg_ext_muted [label="borrowed, no reading cost", shape=box, fillcolor="#f5f5f5", style="dashed", fontsize=9]
    }

    disclaimer [label="\"Tokens\" measure how much reading the AI must do (~4 characters = 1 token)\nSolid border = part of this project (measured here)\nDashed + red = borrowed from elsewhere, adds hidden reading cost (not measured here)\nDashed + muted = borrowed from elsewhere, no reading cost\nNot counted: work done by helper sessions, or anything decided while running", shape=note, fillcolor="#eceff1", style="filled", fontsize=9]

    ext_githttps___github_com_microsoft_amplifier_foundation_main [label="Amplifier Foundation — Shared Base Kit\nBorrowed from another project; brings its own reading cost", shape=box, fillcolor="#80cbc4", style="dashed", color="red", penwidth=2]

    root_wayfinder -> ext_githttps___github_com_microsoft_amplifier_foundation_main [style=dashed]
    root_wayfinder -> beh_wayfinder_behavior [label="builds on"]
    beh_wayfinder_behavior -> ctx_wayfinder_voice_md [style=dotted, color=purple]
    beh_wayfinder_behavior -> ctx_propose_and_ack_md [style=dotted, color=purple]
    beh_wayfinder_behavior -> ctx_offer_catalog_md [style=dotted, color=purple]
}